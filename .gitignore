# Installed dependencies: restore with `bun install --cwd skills/benchtop/scripts`
node_modules

# Generated by the skill's own scripts from project.json; rebuilt by build.ts
skills/benchtop/examples/*/out/
skills/benchtop/examples/*/dist/
skills/benchtop/examples/*/pcb/
skills/benchtop/examples/*/firmware/.pio/
skills/benchtop/examples/*/firmware/compile-*.log

# Tool caches and eval run output
.tscircuit/
skills/benchtop/evals/results/

# Never commit these
.env
.env.*
*.pem
*.key

.DS_Store

# Third-party originals for geometry evidence: fetched locally, never distributed
skills/benchtop/assets/geometry-evidence/sources/
